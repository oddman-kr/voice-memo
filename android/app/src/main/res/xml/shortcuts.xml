<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="record"
        android:enabled="true"
        android:icon="@drawable/sc_mic"
        android:shortcutShortLabel="@string/sc_record">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="kr.oddman.voicememo"
            android:targetClass="kr.oddman.voicememo.RecordActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="meeting"
        android:enabled="true"
        android:icon="@drawable/sc_meeting"
        android:shortcutShortLabel="@string/sc_meeting">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="kr.oddman.voicememo"
            android:targetClass="kr.oddman.voicememo.RecordActivity">
            <extra android:name="mode" android:value="meeting" />
        </intent>
    </shortcut>
</shortcuts>
